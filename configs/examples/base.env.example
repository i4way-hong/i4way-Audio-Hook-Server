# Common settings for all containers
NODE_ENV=production
PORT=3000
LOG_LEVEL=info

# Optional integration
CONVERSATION_LOOKUP_URL=
CONVERSATION_LOOKUP_TOKEN=

# Recording storage: local | s3
RECORDING_STORAGE=local

# If using S3 (uncomment and fill)
# S3_BUCKET=audiohook-recordings
# S3_PREFIX=sessions/
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=ap-northeast-2

# External API/STT (optional)
# API_KEY=
# STT_VENDOR=
# STT_API_KEY=
