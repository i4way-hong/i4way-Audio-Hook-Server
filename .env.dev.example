#############################################
# AudioHook .env.dev.example (로컬 개발용)
# - 로컬 Node 실행 기준(프록시 없이 테스트 가능)
# - 필요 시 값을 채우거나 주석을 해제하세요
#############################################

########################
# 1. 기본 런타임
########################
NODE_ENV=development
SERVERHOST=127.0.0.1           # 로컬 전용 리스닝(외부 노출X)
SERVERPORT=3000

########################
# 2. 녹취/저장 관련
########################
RECORDING_DIR=./recordings
RECORDING_TO_FILE_ENABLED=true
RECORDING_IMMEDIATE_ROTATE=true
# 로컬에서 S3 업로드가 필요하면 버킷 지정
RECORDING_S3_BUCKET=

########################
# 3. 정적 API Key 매핑(샘플)
########################
STATIC_API_KEY_MAP={"R2VuZXN5c2Nsb3Vk":"YTEyMzQ1Njc4OQ=="}

########################
# 4. Secrets(선택)
########################
SECRET_NAME_OR_ARN=

########################
# 5. STT (Speech-To-Text)
########################
STT_ENABLED=true
STT_PROTOCOL=tcp               # websocket | tcp | grpc | mrcp
STT_ENDPOINT=tcp://127.0.0.1:7070
STT_ENCODING=L16               # L16 | PCMU
STT_RATE=8000                  # 8000 | 16000 | 44100 | 48000
STT_MONO=true
STT_RESAMPLE_ENABLED=false

# WebSocket 옵션(WS 사용 시)
STT_WS_INIT_JSON={"type":"init","sampleRate":8000}
STT_WS_PING_SEC=30
STT_WS_BYE_JSON={"type":"bye"}
# STT_WS_MODE=binary            # binary | json-base64
# STT_WS_SUBPROTOCOL=
# STT_WS_JSON_AUDIO_KEY=audio

# TCP 옵션(TCP 사용 시)
STT_TCP_FRAMING=raw            # raw | len32 | newline
STT_TCP_INIT_HEX=0a0b0c
STT_TCP_BYE_HEX=ff00
STT_TCP_TLS=false
# STT_TCP_TLS_REJECT_UNAUTHORIZED=true
# STT_TCP_TLS_SERVERNAME=
# STT_TCP_TLS_CA_FILE=
# STT_TCP_TLS_CERT_FILE=
# STT_TCP_TLS_KEY_FILE=

# 재연결(선택)
STT_RECONNECT_ENABLED=false
# STT_RECONNECT_INITIAL_MS=500
# STT_RECONNECT_MAX_MS=10000
# STT_RECONNECT_FACTOR=2.0

# 벤더 플러그인(선택)
# STT_VENDOR_PLUGIN=
# STT_VENDOR_PARAMS=

########################
# 6. Conversation Lookup(선택)
########################
CONVERSATION_LOOKUP_URL=
CONVERSATION_LOOKUP_QUERY_PARAM=conversation_id
CONVERSATION_LOOKUP_TIMEOUT_MS=3000
CONVERSATION_LOOKUP_CACHE_SECONDS=30

########################
# 7. 로깅
########################
LOG_LEVEL=debug                # 개발 기본: debug
LOG_DIR=./logs
LOG_PREFIX=app
LOG_MAX_MB=50
LOG_RETENTION_DAYS=7

########################
# 8. gRPC Forwarder (grpc 사용 시 선택)
########################
# 기본적으로 로컬 개발에선 비활성/미설정 권장
# STT_GRPC_AUTH_TOKEN=
# STT_GRPC_RECONNECT_ENABLED=false
# STT_GRPC_RECONNECT_INITIAL_MS=1000
# STT_GRPC_RECONNECT_MAX_MS=15000
# STT_GRPC_RECONNECT_FACTOR=2.0
# STT_GRPC_RECONNECT_JITTER=0.3
# STT_GRPC_TLS_ENABLED=false
# STT_GRPC_TLS_CA_FILE=certs/ca.pem
# STT_GRPC_TLS_CERT_FILE=certs/client.crt
# STT_GRPC_TLS_KEY_FILE=certs/client.key
# STT_GRPC_TLS_OVERRIDE_AUTHORITY=localhost
# STT_GRPC_KEEPALIVE_MS=20000
# TRACEPARENT=
