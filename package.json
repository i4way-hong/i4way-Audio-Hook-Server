{
  "name": "audiohook-sample-server",
  "version": "1.0.3",
  "private": true,
  "author": "felix.wyss@genesys.com",
  "license": "MIT",
  "description": "",
  "main": "src/index.ts",
  "engines": {
    "node": ">=22.0.0",
    "npm": ">=10.0.0"
  },
  "scripts": {
    "setup": "npm install",
    "start": "ts-node src/index.ts",
    "build": "tsc --project tsconfig.json --pretty && npm run lint",
    "build:ts": "tsc --project tsconfig.json --pretty",
    "buildcheck": "tsc --project tsconfig.json --pretty --noEmit && npm run lint",
    "lint": "eslint . --ext .ts --cache --max-warnings 0",
    "test": "jest",
    "update": "ncu -t minor -u && npm install",
    "clean": "rm -r dist/",
    "sidecar": "ts-node audiohook/src/sidecar/server.ts",
    "sidecar:build": "tsc --project tsconfig.json --pretty && node dist/audiohook/src/sidecar/server.js",
    "sidecar:mock": "ts-node scripts/mrcp-sidecar-mock.ts",
    "build:native": "node-gyp configure build --directory ./audiohook/src/sidecar/signaling/native",
    "start:grpc-test": "(cd stt_grpc_test && npm install --no-audit --no-fund && npm start)",
    "send:rtp": "ts-node scripts/send_rtp_pcmu_example.ts"
  },
  "keywords": [],
  "dependencies": {
    "@aws-sdk/client-dynamodb": "3.297.0",
    "@aws-sdk/client-s3": "3.297.0",
    "@aws-sdk/client-secrets-manager": "3.297.0",
    "@fastify/websocket": "^10.0.1",
    "@grpc/grpc-js": "^1.14.0",
    "@grpc/proto-loader": "^0.8.0",
  "audiohook-sample-server": "file:audiohook-sample-server-1.0.3.tgz",
    "bytebuffer": "5.0.1",
    "dotenv": "16.0.3",
    "fastify": "4.29.1",
    "fastify-plugin": "3.0.1",
    "install": "0.13.0",
    "object-hash": "3.0.0",
    "pino": "8.11.0",
    "pino-pretty": "8.1.0",
    "tdigest": "0.1.2",
    "uuid": "8.3.2",
    "ws": "^8.17.0"
  },
  "devDependencies": {
    "@aws-sdk/client-transcribe-streaming": "3.529.0",
    "@jest/types": "29.6.3",
    "@types/aws-sdk": "2.7.0",
    "@types/bytebuffer": "5.0.44",
    "@types/jest": "29.5.12",
    "@types/node": "22.5.1",
    "@types/object-hash": "2.2.1",
    "@types/uuid": "8.3.4",
    "@types/ws": "8.5.4",
    "@typescript-eslint/eslint-plugin": "7.18.0",
    "@typescript-eslint/parser": "7.18.0",
    "eslint": "8.57.0",
    "jest": "29.7.0",
    "node-gyp": "^10.0.1",
    "ts-jest": "29.2.1",
    "ts-node": "^10.9.2",
    "typescript": "5.5.4"
  },
  "optionalDependencies": {
    "node-addon-api": "^7.0.0",
    "node-gyp-build": "^4.8.0"
  }
}
