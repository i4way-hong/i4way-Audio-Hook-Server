#############################################
# AudioHook .env.prod.example (프로덕션/컨테이너용)
# - 프록시(Traefik/Nginx) 뒤에서 동작 가정
# - 최소/권장 설정만 포함, 필요 시 확장
#############################################

########################
# 1. 기본 런타임
########################
NODE_ENV=production
SERVERHOST=0.0.0.0            # 컨테이너에서 모든 인터페이스 리스닝
SERVERPORT=3000               # 프록시가 외부 80/443 → 내부 3000 라우팅

########################
# 2. 녹취/저장 관련
########################
RECORDING_DIR=/app/recordings # 컨테이너 내부 경로(호스트 볼륨 마운트 권장)
RECORDING_TO_FILE_ENABLED=true
RECORDING_IMMEDIATE_ROTATE=true
# S3 사용 시 버킷 지정 후 AWS 자격증명은 안전한 비밀 저장소 권장
RECORDING_S3_BUCKET=

########################
# 3. API Key 정적 매핑(선택)
########################
# STATIC_API_KEY_MAP={"R2VuZXN5c2Nsb3Vk":"YTEyMzQ1Njc4OQ=="}

########################
# 4. Secrets(선택)
########################
SECRET_NAME_OR_ARN=

########################
# 5. STT (프로덕션 권장 기본)
########################
STT_ENABLED=true
STT_PROTOCOL=tcp               # websocket|tcp|grpc|mrcp 중 환경에 맞게
STT_ENDPOINT=host:7070         # 실제 STT 엔드포인트 지정
STT_ENCODING=L16
STT_RATE=8000
STT_MONO=true
STT_RESAMPLE_ENABLED=false

# 재연결(고가용 STT 필요 시)
STT_RECONNECT_ENABLED=true
STT_RECONNECT_INITIAL_MS=500
STT_RECONNECT_MAX_MS=10000
STT_RECONNECT_FACTOR=2.0

########################
# 6. Conversation Lookup(선택)
########################
CONVERSATION_LOOKUP_URL=
CONVERSATION_LOOKUP_QUERY_PARAM=conversation_id
CONVERSATION_LOOKUP_TIMEOUT_MS=2000
CONVERSATION_LOOKUP_CACHE_SECONDS=30

########################
# 7. 로깅
########################
LOG_LEVEL=info                 # 운영 기본: info
LOG_DIR=/app/logs              # 볼륨 마운트(호스트 보존)
LOG_PREFIX=app
LOG_MAX_MB=200                 # 운영: 더 큰 단위 권장
LOG_RETENTION_DAYS=14          # 운영: 보존일수 확장

########################
# 8. 확장 옵션(필요 시 주석 해제)
########################
# STT_WS_INIT_JSON={"type":"init","sampleRate":8000}
# STT_WS_PING_SEC=30
# STT_WS_BYE_JSON={"type":"bye"}
# STT_TCP_FRAMING=raw
# STT_TCP_INIT_HEX=0a0b0c
# STT_TCP_BYE_HEX=ff00
# STT_TCP_TLS=false
# STT_VENDOR_PLUGIN=
# STT_VENDOR_PARAMS=

########################
# 9. gRPC Forwarder (STT_PROTOCOL=grpc 운영 시 권장 설정)
########################
# 인증 토큰(Bearer <token>) 필요하면 지정
# STT_GRPC_AUTH_TOKEN=

# 개별 재연결 오버라이드 (STT_RECONNECT_* 보다 우선 적용 가능)
STT_GRPC_RECONNECT_ENABLED=true
STT_GRPC_RECONNECT_INITIAL_MS=1000
STT_GRPC_RECONNECT_MAX_MS=15000
STT_GRPC_RECONNECT_FACTOR=2.0
STT_GRPC_RECONNECT_JITTER=0.3

# TLS/mTLS (필요 시 활성화)
# STT_GRPC_TLS_ENABLED=true
# STT_GRPC_TLS_CA_FILE=/certs/ca.pem
# STT_GRPC_TLS_CERT_FILE=/certs/client.crt
# STT_GRPC_TLS_KEY_FILE=/certs/client.key
# STT_GRPC_TLS_OVERRIDE_AUTHORITY=stt.internal

# Keepalive ping (지속 연결 시 권장)
# STT_GRPC_KEEPALIVE_MS=20000

# 분산 추적 W3C TraceContext 전달 값
# TRACEPARENT=
