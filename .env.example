#############################################
# AudioHook .env 예시 (배포/개발 공용)
# - 필요 없는 값은 삭제하거나 비워둘 수 있습니다
# - true/false 형식: true|false|1|0|yes|no|on|off 인식
#############################################

########################
# 1. 기본 런타임
########################
NODE_ENV=development         # production / development
SERVERHOST=0.0.0.0           # 컨테이너/서버가 리스닝할 IP (프록시 뒤면 0.0.0.0 권장)
SERVERPORT=3000              # 외부 노출 포트는 프록시/호스트 포트 매핑으로 제어

########################
# 2. 녹취/저장 관련
########################
RECORDING_DIR=./recordings   # 로컬 저장 경로 (컨테이너 볼륨 마운트 권장)
RECORDING_TO_FILE_ENABLED=true
RECORDING_IMMEDIATE_ROTATE=true   # 디렉터리/세션 경로 바뀔 때 즉시 회전
# S3 업로드(선택): 사용 시 bucket 지정 및 AWS 자격 증명 설정
RECORDING_S3_BUCKET=

########################
# 3. 정적 API Key 매핑 (Base64 → Base64)
########################
# 예: Genesyscloud/a123456789 샘플
STATIC_API_KEY_MAP={"R2VuZXN5c2Nsb3Vk":"YTEyMzQ1Njc4OQ=="}

########################
# 4. Secrets / 외부 비밀 저장소 (선택)
########################
SECRET_NAME_OR_ARN=

########################
# 5. STT (Speech-To-Text) 설정
########################
STT_ENABLED=true             # 비활성하려면 false
STT_PROTOCOL=tcp             # websocket | tcp | grpc | mrcp
#STT_ENDPOINT=ws://172.168.10.211:8080/stt
STT_ENDPOINT=tcp://127.0.0.1:7070
STT_ENCODING=L16             # L16 | PCMU
STT_RATE=8000                # 8000 | 16000 | 44100 | 48000
STT_MONO=true
STT_RESAMPLE_ENABLED=false

# WebSocket 전용 옵션
STT_WS_INIT_JSON={"type":"init","sampleRate":8000}
STT_WS_PING_SEC=30
STT_WS_BYE_JSON={"type":"bye"}
# STT_WS_MODE=binary          # binary | json-base64 (기본 binary)
# STT_WS_SUBPROTOCOL=
# STT_WS_JSON_AUDIO_KEY=audio

# TCP 전용 옵션
STT_TCP_FRAMING=raw          # raw | len32 | newline
STT_TCP_INIT_HEX=0a0b0c
STT_TCP_BYE_HEX=ff00
STT_TCP_TLS=false            # true면 아래 TLS 관련 값 사용
# STT_TCP_TLS_REJECT_UNAUTHORIZED=true
# STT_TCP_TLS_SERVERNAME=
# STT_TCP_TLS_CA_FILE=
# STT_TCP_TLS_CERT_FILE=
# STT_TCP_TLS_KEY_FILE=

# 재연결 옵션 (grpc/tcp/ws 공용 가능)
STT_RECONNECT_ENABLED=false
# STT_RECONNECT_INITIAL_MS=500
# STT_RECONNECT_MAX_MS=10000
# STT_RECONNECT_FACTOR=2.0

# 벤더 플러그인(선택)
# STT_VENDOR_PLUGIN=
# STT_VENDOR_PARAMS=

########################
# 6. Conversation Lookup (선택 기능)
########################
CONVERSATION_LOOKUP_URL=
CONVERSATION_LOOKUP_QUERY_PARAM=conversation_id
CONVERSATION_LOOKUP_TIMEOUT_MS=3000
CONVERSATION_LOOKUP_CACHE_SECONDS=30

########################
# 7. 로깅
########################
LOG_LEVEL=debug              # trace|debug|info|warn|error|fatal|silent
LOG_DIR=./logs               # 컨테이너에서는 마운트 권장
LOG_PREFIX=app
LOG_MAX_MB=50
LOG_RETENTION_DAYS=7

########################
# 8. 기타(확장 여지)
########################
# 추가 환경 변수가 필요할 때 이 영역 사용